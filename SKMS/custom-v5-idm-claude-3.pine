//@version=6

indicator("SK Market Structure", "SKMS", overlay=true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ─── Color scheme ────────────────────────────────────────────────
GREEN = #089981
RED   = #F23645
BLUE  = #368ef2
GRAY  = #787B86
LABEL_LINE_GAP = ta.atr(200) * 0.7
LABEL_SIZE     = size.normal

// ─── Inputs ──────────────────────────────────────────────────────
showInternalStructure = input.bool(false, "Show Internal Structure")
iStructureStartPoint  = input.string("Last IB", "Internal Structure Start Point", options=["Breakout Candle", "Last IB"])
confirmMethod         = input.string("IB Breakout", "External Last High/Low Confirm Method", options=["IB Breakout", "IDM Point"])

// ─── Types ───────────────────────────────────────────────────────
enum bias
    BULLISH
    BEARISH

type trend
    bias bias

type pivot
    float price
    confirmed = false
    int barIndex = bar_index

type LastIndependentBullishBar
    float low
    int barIndex = bar_index

type LastIndependentBearishBar
    float high
    int barIndex = bar_index

// Types for IDM swing detection
type candleRange
    float high
    float low

type swingPoint
    float price
    int   barIndex

// ─── safeX1 ──────────────────────────────────────────────────────
safeX1(int idx) =>
    math.max(idx, bar_index - 4999)

// ─── Lowest / Highest helpers ────────────────────────────────────
getLowestLow(int fromIndex, int toIndex) =>
    float lowestLow    = low
    int   lowestBarIdx = bar_index
    for i = 0 to (toIndex - fromIndex)
        int idx = bar_index - i
        if idx >= fromIndex
            if low[i] < lowestLow
                lowestLow    := low[i]
                lowestBarIdx := idx
    [lowestLow, lowestBarIdx]

getHighestHigh(int fromIndex, int toIndex) =>
    float highestHigh   = high
    int   highestBarIdx = bar_index
    for i = 0 to (toIndex - fromIndex)
        int idx = bar_index - i
        if idx >= fromIndex
            if high[i] > highestHigh
                highestHigh   := high[i]
                highestBarIdx := idx
    [highestHigh, highestBarIdx]

// ─── IDM: Get swing highs in bearish wave (confirmHigh → lastLow) ─
// Used for bearish trend IDM detection
// barsBackFirst = bar_index - lastLow.barIndex (most recent = smallest barsBack)
// barsBackLast  = bar_index - confirmHigh.barIndex (oldest = largest barsBack)
// We scan oldest → newest, detecting IB-based swing highs
// Returns array of swingPoints sorted oldest to newest
getBearishWaveSwingHighs(int barsBackFirst, int barsBackLast) =>
    lastIBRange           = candleRange.new(na, na)
    swingPoints           = array.new<swingPoint>()
    float unconfPrice     = na
    int   unconfBar       = na
    bool  isLiqSwept      = false
    int   rangeSize       = barsBackLast - barsBackFirst

    // iterate from oldest bar to newest
    for j = 0 to rangeSize
        int i = barsBackLast - j   // oldest first → newest last
        float cH = high[i]
        float cL = low[i]
        float cO = open[i]
        float cC = close[i]
        int   cBar = bar_index - i

        if na(lastIBRange.high) or na(lastIBRange.low)
            lastIBRange.high := cH
            lastIBRange.low  := cL
            continue

        bool isTrueInsideBar = cH <= lastIBRange.high and cL >= lastIBRange.low
        bool isBodyInsideBar = cO <= lastIBRange.high and cO >= lastIBRange.low and cC <= lastIBRange.high and cC >= lastIBRange.low

        if isLiqSwept
            if isTrueInsideBar
                // update unconfirmed swing high if this inside bar makes new high
                if cH > unconfPrice
                    unconfPrice := cH
                    unconfBar   := cBar
                continue
            else if cH > unconfPrice
                unconfPrice := cH
                unconfBar   := cBar

            // swing breakout completed: close below IB low
            if cC < lastIBRange.low
                sp = swingPoint.new(unconfPrice, unconfBar)
                swingPoints.push(sp)
                // reset
                unconfPrice  := na
                unconfBar    := na
                isLiqSwept   := false
                lastIBRange.high := cH
                lastIBRange.low  := cL
                continue
            else if cC > lastIBRange.low and cL < lastIBRange.low
                // swept low but closed above → update tracked low
                lastIBRange.low := cL
        else
            if isTrueInsideBar
                continue
            else if isBodyInsideBar and not isTrueInsideBar
                // body inside but wick outside
                if cL < lastIBRange.low and cH < lastIBRange.high
                    // took low of bearish IB, formed subIB
                    lastIBRange.high := cH
                    lastIBRange.low  := cL
                    continue
                else if cH > lastIBRange.high
                    // high liquidity swept → start tracking swing high
                    isLiqSwept  := true
                    unconfPrice := cH
                    unconfBar   := cBar
                else
                    lastIBRange.high := cH
                    lastIBRange.low  := cL
            else
                // fully outside previous IB range
                if cH > lastIBRange.high
                    isLiqSwept  := true
                    unconfPrice := cH
                    unconfBar   := cBar
                    // also update low tracking
                    lastIBRange.low := cL
                else
                    lastIBRange.high := cH
                    lastIBRange.low  := cL

    swingPoints

// ─── IDM: Get swing lows in bullish wave (confirmLow → lastHigh) ──
// Mirror of above for bullish trend
getBullishWaveSwingLows(int barsBackFirst, int barsBackLast) =>
    lastIBRange           = candleRange.new(na, na)
    swingPoints           = array.new<swingPoint>()
    float unconfPrice     = na
    int   unconfBar       = na
    bool  isLiqSwept      = false
    int   rangeSize       = barsBackLast - barsBackFirst

    for j = 0 to rangeSize
        int i = barsBackLast - j   // oldest first → newest last
        float cH = high[i]
        float cL = low[i]
        float cO = open[i]
        float cC = close[i]
        int   cBar = bar_index - i

        if na(lastIBRange.high) or na(lastIBRange.low)
            lastIBRange.high := cH
            lastIBRange.low  := cL
            continue

        bool isTrueInsideBar = cH <= lastIBRange.high and cL >= lastIBRange.low
        bool isBodyInsideBar = cO <= lastIBRange.high and cO >= lastIBRange.low and cC <= lastIBRange.high and cC >= lastIBRange.low

        if isLiqSwept
            if isTrueInsideBar
                if cL < unconfPrice
                    unconfPrice := cL
                    unconfBar   := cBar
                continue
            else if cL < unconfPrice
                unconfPrice := cL
                unconfBar   := cBar

            // swing breakout completed: close above IB high
            if cC > lastIBRange.high
                sp = swingPoint.new(unconfPrice, unconfBar)
                swingPoints.push(sp)
                unconfPrice  := na
                unconfBar    := na
                isLiqSwept   := false
                lastIBRange.high := cH
                lastIBRange.low  := cL
                continue
            else if cC < lastIBRange.high and cH > lastIBRange.high
                lastIBRange.high := cH
        else
            if isTrueInsideBar
                continue
            else if isBodyInsideBar and not isTrueInsideBar
                if cH > lastIBRange.high and cL > lastIBRange.low
                    lastIBRange.high := cH
                    lastIBRange.low  := cL
                    continue
                else if cL < lastIBRange.low
                    isLiqSwept  := true
                    unconfPrice := cL
                    unconfBar   := cBar
                else
                    lastIBRange.high := cH
                    lastIBRange.low  := cL
            else
                if cL < lastIBRange.low
                    isLiqSwept  := true
                    unconfPrice := cL
                    unconfBar   := cBar
                    lastIBRange.high := cH
                else
                    lastIBRange.high := cH
                    lastIBRange.low  := cL

    swingPoints

// ════════════════════════════════════════════════════════════════
//  EXTERNAL STRUCTURE STATE
// ════════════════════════════════════════════════════════════════
var bool  retracementStarted       = false
var float retracementStartLevel    = na
var LastIndependentBullishBar lastIndependentBullishBar = na
var LastIndependentBearishBar lastIndependentBearishBar = na
var pivot lastHigh                 = pivot.new(na, false, na)
var pivot lastLow                  = pivot.new(na, false, na)
var pivot confirmHigh              = pivot.new(na, false, na)
var pivot confirmLow               = pivot.new(na, false, na)
var line  lastLine                 = na
var array<line> structureLines     = array.new<line>()
var line  confirmLow_line          = na
var line  confirmHigh_line         = na
var int   highLowLineHorzOffset    = 30
var trend swingTrend               = trend.new(bias.BULLISH)

// ─── IDM state ───────────────────────────────────────────────────
var float idmLevel                 = na   // current IDM price level
var int   idmBarIndex              = na   // IDM swing point bar index
var line  idmLine                  = na   // IDM line on chart
var bool  idmWatching              = false // watching for IDM sweep

// ════════════════════════════════════════════════════════════════
//  INTERNAL STRUCTURE STATE
// ════════════════════════════════════════════════════════════════
var bool  iRetracementStarted      = false
var float iRetracementStartLevel   = na
var LastIndependentBullishBar iLastIndBullBar = na
var LastIndependentBearishBar iLastIndBearBar = na
var pivot iLastHigh                = pivot.new(na, false, na)
var pivot iLastLow                 = pivot.new(na, false, na)
var pivot iConfirmHigh             = pivot.new(na, false, na)
var pivot iConfirmLow              = pivot.new(na, false, na)
var trend iSwingTrend              = trend.new(bias.BULLISH)
var bool  iActive                  = false
var int   iStartBarIndex           = na
var float iLastIBLevel             = na
var int   iLastIBBar               = na
var bias  iLastIBBias              = bias.BULLISH
var bool  iPendingLastIB           = false

// ════════════════════════════════════════════════════════════════
//  BOOTSTRAP
// ════════════════════════════════════════════════════════════════
if barstate.isfirst
    if close > open
        swingTrend.bias := bias.BULLISH
        lastHigh        := pivot.new(high)
        confirmLow      := pivot.new(low, true)
    else
        swingTrend.bias := bias.BEARISH
        lastLow         := pivot.new(low)
        confirmHigh     := pivot.new(high, true)

else

    // ── Update confirm line x2 ──────────────────────────────────
    if not na(confirmLow_line)
        confirmLow_line.set_x2(bar_index + highLowLineHorzOffset)
    if not na(confirmHigh_line)
        confirmHigh_line.set_x2(bar_index + highLowLineHorzOffset)

    // ── Update IDM line x2 while watching ──────────────────────
    if idmWatching and not na(idmLine)
        idmLine.set_x2(bar_index + highLowLineHorzOffset)

    previousBarClose = close[1]

    // ════════════════════════════════════════════════════════════
    //  EXTERNAL: update last high / last low
    // ════════════════════════════════════════════════════════════
    if swingTrend.bias == bias.BULLISH
        if close > lastHigh.price and not lastHigh.confirmed
            lastHigh := pivot.new(high)
            if not (open != previousBarClose)
                lastIndependentBullishBar := LastIndependentBullishBar.new(low)
            else
                lastIndependentBullishBar := LastIndependentBullishBar.new(previousBarClose)
            retracementStartLevel := lastIndependentBullishBar.low
            retracementStarted    := false
            if iPendingLastIB and iLastIBBias == bias.BULLISH
                iLastIBLevel := lastIndependentBullishBar.low
                iLastIBBar   := bar_index
        else if high > lastHigh.price and close < lastHigh.price and lastHigh.confirmed
            lastHigh.price := high
        else if high > lastHigh.price and close < lastHigh.price and not lastHigh.confirmed
            lastHigh := pivot.new(high)
    else if swingTrend.bias == bias.BEARISH
        if close < lastLow.price and not lastLow.confirmed
            lastLow := pivot.new(low)
            if not (open != previousBarClose)
                lastIndependentBearishBar := LastIndependentBearishBar.new(high)
            else
                lastIndependentBearishBar := LastIndependentBearishBar.new(previousBarClose)
            retracementStartLevel := lastIndependentBearishBar.high
            retracementStarted    := false
            if iPendingLastIB and iLastIBBias == bias.BEARISH
                iLastIBLevel := lastIndependentBearishBar.high
                iLastIBBar   := bar_index
        else if low < lastLow.price and close > lastLow.price and lastLow.confirmed
            lastLow.price := low
        else if low < lastLow.price and close > lastLow.price and not lastLow.confirmed
            lastLow := pivot.new(low)

    // ── EXTERNAL: update confirm high / confirm low ─────────────
    if swingTrend.bias == bias.BULLISH
        if not na(confirmLow.price) and low < confirmLow.price and close > confirmLow.price and confirmLow.confirmed
            confirmLow.price := low
            confirmLow_line.set_y1(confirmLow.price)
            confirmLow_line.set_y2(confirmLow.price)
        else if not na(confirmLow.price) and low < confirmLow.price and close > confirmLow.price and not confirmLow.confirmed
            confirmLow := pivot.new(low)
    else if swingTrend.bias == bias.BEARISH
        if not na(confirmHigh.price) and high > confirmHigh.price and close < confirmHigh.price and confirmHigh.confirmed
            confirmHigh.price := high
            confirmHigh_line.set_y1(confirmHigh.price)
            confirmHigh_line.set_y2(confirmHigh.price)
        else if not na(confirmHigh.price) and high > confirmHigh.price and close < confirmHigh.price and not confirmHigh.confirmed
            confirmHigh := pivot.new(high)

    // ── EXTERNAL: retracement start check ──────────────────────
    if not retracementStarted and not na(retracementStartLevel)
        if swingTrend.bias == bias.BULLISH
            if close < retracementStartLevel

                if confirmMethod == "IB Breakout"
                    // Original behavior
                    retracementStarted    := true
                    retracementStartLevel := na
                    lastHigh.confirmed    := true
                else
                    // IDM mode: scan impulse wave for nearest swing low to lastHigh
                    // Range: confirmLow.barIndex → lastHigh.barIndex
                    // barsBackFirst = bar_index - lastHigh.barIndex (newest, smallest offset)
                    // barsBackLast  = bar_index - confirmLow.barIndex (oldest, largest offset)
                    retracementStarted    := true
                    retracementStartLevel := na
                    // lastHigh stays UNCONFIRMED until IDM sweep

                    if not na(confirmLow.barIndex) and not na(lastHigh.barIndex)
                        int bbFirst = bar_index - lastHigh.barIndex
                        int bbLast  = bar_index - confirmLow.barIndex
                        swingLows   = bbLast > bbFirst ? getBullishWaveSwingLows(bbFirst, bbLast) : array.new<swingPoint>()
                        int swCount = swingLows.size()
                        if swCount > 0
                            // Nearest to lastHigh = last element (scanned oldest→newest)
                            sp = swingLows.get(swCount - 1)
                            idmLevel    := sp.price
                            idmBarIndex := sp.barIndex
                            idmWatching := true
                            // Draw IDM line: from IDM bar to current bar (extends while watching)
                            // if not na(idmLine)
                            //     idmLine.delete()
                            // idmLine := line.new(x1=safeX1(idmBarIndex), y1=idmLevel, x2=bar_index + highLowLineHorzOffset, y2=idmLevel, color=GRAY, width=1)
                        else
                            // No IDM found → confirm lastHigh normally (fallback)
                            lastHigh.confirmed := true

                // Internal Last IB mode activation
                if iPendingLastIB and not na(iLastIBLevel)
                    iPendingLastIB         := false
                    iRetracementStarted    := false
                    iRetracementStartLevel := na
                    iLastIndBullBar        := na
                    iLastIndBearBar        := na
                    iLastHigh    := pivot.new(iLastIBLevel, false, iLastIBBar)
                    iConfirmLow  := pivot.new(iLastIBLevel, true,  iLastIBBar)
                    iLastLow     := pivot.new(na, false, na)
                    iConfirmHigh := pivot.new(na, false, na)
                    iSwingTrend.bias := bias.BULLISH

            else if low < retracementStartLevel
                retracementStartLevel := low

        else if swingTrend.bias == bias.BEARISH
            if close > retracementStartLevel

                if confirmMethod == "IB Breakout"
                    retracementStarted    := true
                    retracementStartLevel := na
                    lastLow.confirmed     := true
                else
                    // IDM mode: scan impulse wave for nearest swing high to lastLow
                    // Range: confirmHigh.barIndex → lastLow.barIndex
                    retracementStarted    := true
                    retracementStartLevel := na
                    // lastLow stays UNCONFIRMED until IDM sweep

                    if not na(confirmHigh.barIndex) and not na(lastLow.barIndex)
                        int bbFirst = bar_index - lastLow.barIndex
                        int bbLast  = bar_index - confirmHigh.barIndex
                        swingHighs  = bbLast > bbFirst ? getBearishWaveSwingHighs(bbFirst, bbLast) : array.new<swingPoint>()
                        int swCount = swingHighs.size()
                        if swCount > 0
                            sp = swingHighs.get(swCount - 1)
                            idmLevel    := sp.price
                            idmBarIndex := sp.barIndex
                            idmWatching := true
                            // if not na(idmLine)
                            //     idmLine.delete()
                            // idmLine := line.new(x1=safeX1(idmBarIndex), y1=idmLevel, x2=bar_index, y2=idmLevel, color=GRAY, width=1)
                        else
                            lastLow.confirmed := true

                if iPendingLastIB and not na(iLastIBLevel)
                    iPendingLastIB         := false
                    iRetracementStarted    := false
                    iRetracementStartLevel := na
                    iLastIndBullBar        := na
                    iLastIndBearBar        := na
                    iLastLow     := pivot.new(iLastIBLevel, false, iLastIBBar)
                    iConfirmHigh := pivot.new(iLastIBLevel, true,  iLastIBBar)
                    iLastHigh    := pivot.new(na, false, na)
                    iConfirmLow  := pivot.new(na, false, na)
                    iSwingTrend.bias := bias.BEARISH

            else if high > retracementStartLevel
                retracementStartLevel := high

    // ════════════════════════════════════════════════════════════
    //  IDM SWEEP WATCH (tick by bar)
    //  Bullish: low <= idmLevel → lastHigh confirmed
    //  Bearish: high >= idmLevel → lastLow confirmed
    // ════════════════════════════════════════════════════════════
    if idmWatching and confirmMethod == "IDM Point" and not na(idmLevel)
        if swingTrend.bias == bias.BULLISH
            if low <= idmLevel
                lastHigh.confirmed := true
                idmWatching        := false
                // Trim IDM line x2 to this bar
                if not na(idmLine)
                    // idmLine.set_x2(bar_index)
                    idmLine := line.new(x1=safeX1(idmBarIndex), y1=idmLevel, x2=bar_index, y2=idmLevel, color=GRAY, width=1)
        else if swingTrend.bias == bias.BEARISH
            if high >= idmLevel
                lastLow.confirmed := true
                idmWatching       := false
                if not na(idmLine)
                    // idmLine.set_x2(bar_index)
                    idmLine := line.new(x1=safeX1(idmBarIndex), y1=idmLevel, x2=bar_index, y2=idmLevel, color=GRAY, width=1)

    // ════════════════════════════════════════════════════════════
    //  EXTERNAL: BOS / CHOCH detection
    // ════════════════════════════════════════════════════════════
    if retracementStarted
        if swingTrend.bias == bias.BULLISH

            // Bearish CHOCH
            if not na(confirmLow.price) and close < confirmLow.price and confirmLow.confirmed
                _line = line.new(x1=safeX1(confirmLow.barIndex), y1=confirmLow.price, x2=bar_index, y2=confirmLow.price, color=RED, width=1)
                structureLines.push(_line)
                int mid = math.round((bar_index + confirmLow.barIndex) / 2)
                label.new(mid, confirmLow.price - LABEL_LINE_GAP, "CHOCH", style=label.style_label_center, textcolor=RED, color=color.new(color.white, 100), size=LABEL_SIZE)
                int fromIdx = confirmLow.barIndex
                [hh, hhBar] = getHighestHigh(fromIdx, bar_index)
                confirmHigh := pivot.new(hh, true, hhBar)
                swingTrend.bias := bias.BEARISH
                lastLow := pivot.new(low)
                confirmLow_line.delete()
                confirmHigh_line := line.new(x1=safeX1(hhBar), y1=hh, x2=bar_index + highLowLineHorzOffset, y2=hh, color=BLUE, width=1)
                retracementStarted    := false
                lastIndependentBearishBar := LastIndependentBearishBar.new(high)
                retracementStartLevel := lastIndependentBearishBar.high
                // Reset IDM
                idmWatching := false
                idmLevel    := na
                idmBarIndex := na
                // Internal reset
                iActive := true
                iStartBarIndex := bar_index
                iRetracementStarted := false
                iRetracementStartLevel := na
                iLastIndBullBar := na
                iLastIndBearBar := na
                iSwingTrend.bias := bias.BEARISH
                iLastLow    := pivot.new(low,  false, bar_index)
                iConfirmHigh := pivot.new(high, true,  bar_index)
                iLastHigh   := pivot.new(na, false, na)
                iConfirmLow := pivot.new(na, false, na)
                iPendingLastIB := (iStructureStartPoint == "Last IB")
                iLastIBLevel := na
                iLastIBBar   := na
                iLastIBBias  := bias.BEARISH

            // Bullish BOS
            else if not na(lastHigh.price) and close > lastHigh.price and lastHigh.confirmed
                _line = line.new(x1=safeX1(lastHigh.barIndex), y1=lastHigh.price, x2=bar_index, y2=lastHigh.price, color=GREEN, width=1)
                structureLines.push(_line)
                int mid = math.round((bar_index + lastHigh.barIndex) / 2)
                label.new(mid, lastHigh.price + LABEL_LINE_GAP, "BOS", style=label.style_label_center, textcolor=GREEN, color=color.new(color.white, 100), size=LABEL_SIZE)
                int fromIdx = lastHigh.barIndex
                [ll, llBar] = getLowestLow(fromIdx, bar_index)
                confirmLow  := pivot.new(ll, true, llBar)
                lastHigh    := pivot.new(high)
                confirmLow_line.delete()
                confirmLow_line := line.new(x1=safeX1(llBar), y1=ll, x2=bar_index + highLowLineHorzOffset, y2=ll, color=BLUE, width=1)
                retracementStarted    := false
                lastIndependentBullishBar := LastIndependentBullishBar.new(low)
                retracementStartLevel := lastIndependentBullishBar.low
                // Reset IDM
                idmWatching := false
                idmLevel    := na
                idmBarIndex := na
                // Internal reset
                iActive := true
                iStartBarIndex := bar_index
                iRetracementStarted := false
                iRetracementStartLevel := na
                iLastIndBullBar := na
                iLastIndBearBar := na
                iSwingTrend.bias := bias.BULLISH
                iLastHigh   := pivot.new(high, false, bar_index)
                iConfirmLow := pivot.new(low,  true,  bar_index)
                iLastLow    := pivot.new(na, false, na)
                iConfirmHigh := pivot.new(na, false, na)
                iPendingLastIB := (iStructureStartPoint == "Last IB")
                iLastIBLevel := na
                iLastIBBar   := na
                iLastIBBias  := bias.BULLISH

        else if swingTrend.bias == bias.BEARISH

            // Bullish CHOCH
            if not na(confirmHigh.price) and close > confirmHigh.price and confirmHigh.confirmed
                _line = line.new(x1=safeX1(confirmHigh.barIndex), y1=confirmHigh.price, x2=bar_index, y2=confirmHigh.price, color=GREEN, width=1)
                structureLines.push(_line)
                int mid = math.round((bar_index + confirmHigh.barIndex) / 2)
                label.new(mid, confirmHigh.price + LABEL_LINE_GAP, "CHOCH", style=label.style_label_center, textcolor=GREEN, color=color.new(color.white, 100), size=LABEL_SIZE)
                int fromIdx = confirmHigh.barIndex
                [ll, llBar] = getLowestLow(fromIdx, bar_index)
                confirmLow  := pivot.new(ll, true, llBar)
                swingTrend.bias := bias.BULLISH
                lastHigh := pivot.new(high)
                confirmHigh_line.delete()
                confirmLow_line := line.new(x1=safeX1(llBar), y1=ll, x2=bar_index + highLowLineHorzOffset, y2=ll, color=BLUE, width=1)
                retracementStarted    := false
                lastIndependentBullishBar := LastIndependentBullishBar.new(low)
                retracementStartLevel := lastIndependentBullishBar.low
                // Reset IDM
                idmWatching := false
                idmLevel    := na
                idmBarIndex := na
                // Internal reset
                iActive := true
                iStartBarIndex := bar_index
                iRetracementStarted := false
                iRetracementStartLevel := na
                iLastIndBullBar := na
                iLastIndBearBar := na
                iSwingTrend.bias := bias.BULLISH
                iLastHigh   := pivot.new(high, false, bar_index)
                iConfirmLow := pivot.new(low,  true,  bar_index)
                iLastLow    := pivot.new(na, false, na)
                iConfirmHigh := pivot.new(na, false, na)
                iPendingLastIB := (iStructureStartPoint == "Last IB")
                iLastIBLevel := na
                iLastIBBar   := na
                iLastIBBias  := bias.BULLISH

            // Bearish BOS
            else if not na(lastLow.price) and close < lastLow.price and lastLow.confirmed
                _line = line.new(x1=safeX1(lastLow.barIndex), y1=lastLow.price, x2=bar_index, y2=lastLow.price, color=RED, width=1)
                structureLines.push(_line)
                int mid = math.round((bar_index + lastLow.barIndex) / 2)
                label.new(mid, lastLow.price - LABEL_LINE_GAP, "BOS", style=label.style_label_center, textcolor=RED, color=color.new(color.white, 100), size=LABEL_SIZE)
                int fromIdx = lastLow.barIndex
                [hh, hhBar] = getHighestHigh(fromIdx, bar_index)
                confirmHigh := pivot.new(hh, true, hhBar)
                lastLow := pivot.new(low)
                confirmHigh_line.delete()
                confirmHigh_line := line.new(x1=safeX1(hhBar), y1=hh, x2=bar_index + highLowLineHorzOffset, y2=hh, color=BLUE, width=1)
                retracementStarted    := false
                lastIndependentBearishBar := LastIndependentBearishBar.new(high)
                retracementStartLevel := lastIndependentBearishBar.high
                // Reset IDM
                idmWatching := false
                idmLevel    := na
                idmBarIndex := na
                // Internal reset
                iActive := true
                iStartBarIndex := bar_index
                iRetracementStarted := false
                iRetracementStartLevel := na
                iLastIndBullBar := na
                iLastIndBearBar := na
                iSwingTrend.bias := bias.BEARISH
                iLastLow    := pivot.new(low,  false, bar_index)
                iConfirmHigh := pivot.new(high, true,  bar_index)
                iLastHigh   := pivot.new(na, false, na)
                iConfirmLow := pivot.new(na, false, na)
                iPendingLastIB := (iStructureStartPoint == "Last IB")
                iLastIBLevel := na
                iLastIBBar   := na
                iLastIBBias  := bias.BEARISH

    else
        if swingTrend.bias == bias.BULLISH
            if close < confirmLow.price
                swingTrend.bias       := bias.BEARISH
                confirmHigh           := lastHigh
                confirmHigh.confirmed := true
                lastLow               := confirmLow
                confirmLow            := pivot.new(na, false, na)
                lastHigh              := pivot.new(na, false, na)
                lastIndependentBullishBar := LastIndependentBullishBar.new(low)
                retracementStartLevel := lastIndependentBullishBar.low
                retracementStarted    := false
                idmWatching := false
        else if swingTrend.bias == bias.BEARISH
            if close > confirmHigh.price
                swingTrend.bias      := bias.BULLISH
                confirmLow           := lastLow
                confirmLow.confirmed := true
                lastHigh             := confirmHigh
                confirmHigh          := pivot.new(na, false, na)
                lastLow              := pivot.new(na, false, na)
                lastIndependentBearishBar := LastIndependentBearishBar.new(high)
                retracementStartLevel := lastIndependentBearishBar.high
                retracementStarted    := false
                idmWatching := false

    // ════════════════════════════════════════════════════════════
    //  INTERNAL STRUCTURE PROCESSING
    // ════════════════════════════════════════════════════════════
    if iActive and showInternalStructure

        if iPendingLastIB and retracementStarted and not na(iLastIBLevel)
            iPendingLastIB         := false
            iRetracementStarted    := false
            iRetracementStartLevel := na
            iLastIndBullBar        := na
            iLastIndBearBar        := na
            if iLastIBBias == bias.BULLISH
                iLastHigh    := pivot.new(iLastIBLevel, false, iLastIBBar)
                iConfirmLow  := pivot.new(iLastIBLevel, true,  iLastIBBar)
                iLastLow     := pivot.new(na, false, na)
                iConfirmHigh := pivot.new(na, false, na)
                iSwingTrend.bias := bias.BULLISH
            else
                iLastLow     := pivot.new(iLastIBLevel, false, iLastIBBar)
                iConfirmHigh := pivot.new(iLastIBLevel, true,  iLastIBBar)
                iLastHigh    := pivot.new(na, false, na)
                iConfirmLow  := pivot.new(na, false, na)
                iSwingTrend.bias := bias.BEARISH

        if not iPendingLastIB
            iPrevClose = close[1]

            if iSwingTrend.bias == bias.BULLISH
                if close > iLastHigh.price and not iLastHigh.confirmed
                    iLastHigh := pivot.new(high)
                    if not (open != iPrevClose)
                        iLastIndBullBar := LastIndependentBullishBar.new(low)
                    else
                        iLastIndBullBar := LastIndependentBullishBar.new(iPrevClose)
                    iRetracementStartLevel := iLastIndBullBar.low
                    iRetracementStarted    := false
                else if high > iLastHigh.price and close < iLastHigh.price and iLastHigh.confirmed
                    iLastHigh.price := high
                else if high > iLastHigh.price and close < iLastHigh.price and not iLastHigh.confirmed
                    iLastHigh := pivot.new(high)
            else if iSwingTrend.bias == bias.BEARISH
                if close < iLastLow.price and not iLastLow.confirmed
                    iLastLow := pivot.new(low)
                    if not (open != iPrevClose)
                        iLastIndBearBar := LastIndependentBearishBar.new(high)
                    else
                        iLastIndBearBar := LastIndependentBearishBar.new(iPrevClose)
                    iRetracementStartLevel := iLastIndBearBar.high
                    iRetracementStarted    := false
                else if low < iLastLow.price and close > iLastLow.price and iLastLow.confirmed
                    iLastLow.price := low
                else if low < iLastLow.price and close > iLastLow.price and not iLastLow.confirmed
                    iLastLow := pivot.new(low)

            if iSwingTrend.bias == bias.BULLISH
                if not na(iConfirmLow.price) and low < iConfirmLow.price and close > iConfirmLow.price and iConfirmLow.confirmed
                    iConfirmLow.price := low
                else if not na(iConfirmLow.price) and low < iConfirmLow.price and close > iConfirmLow.price and not iConfirmLow.confirmed
                    iConfirmLow := pivot.new(low)
            else if iSwingTrend.bias == bias.BEARISH
                if not na(iConfirmHigh.price) and high > iConfirmHigh.price and close < iConfirmHigh.price and iConfirmHigh.confirmed
                    iConfirmHigh.price := high
                else if not na(iConfirmHigh.price) and high > iConfirmHigh.price and close < iConfirmHigh.price and not iConfirmHigh.confirmed
                    iConfirmHigh := pivot.new(high)

            if not iRetracementStarted and not na(iRetracementStartLevel)
                if iSwingTrend.bias == bias.BULLISH
                    if close < iRetracementStartLevel
                        iRetracementStarted    := true
                        iRetracementStartLevel := na
                        iLastHigh.confirmed    := true
                    else if low < iRetracementStartLevel
                        iRetracementStartLevel := low
                else if iSwingTrend.bias == bias.BEARISH
                    if close > iRetracementStartLevel
                        iRetracementStarted    := true
                        iRetracementStartLevel := na
                        iLastLow.confirmed     := true
                    else if high > iRetracementStartLevel
                        iRetracementStartLevel := high

            if iRetracementStarted
                if iSwingTrend.bias == bias.BULLISH
                    if not na(iConfirmLow.price) and close < iConfirmLow.price and iConfirmLow.confirmed
                        line.new(x1=safeX1(iConfirmLow.barIndex), y1=iConfirmLow.price, x2=bar_index, y2=iConfirmLow.price, color=RED, width=1)
                        int fromIdx = iConfirmLow.barIndex
                        [hh, hhBar] = getHighestHigh(fromIdx, bar_index)
                        iConfirmHigh := pivot.new(hh, true, hhBar)
                        iSwingTrend.bias      := bias.BEARISH
                        iLastLow              := pivot.new(low)
                        iRetracementStarted   := false
                        iLastIndBearBar       := LastIndependentBearishBar.new(high)
                        iRetracementStartLevel := iLastIndBearBar.high
                    else if not na(iLastHigh.price) and close > iLastHigh.price and iLastHigh.confirmed
                        line.new(x1=safeX1(iLastHigh.barIndex), y1=iLastHigh.price, x2=bar_index, y2=iLastHigh.price, color=GREEN, width=1)
                        int fromIdx = iLastHigh.barIndex
                        [ll, llBar] = getLowestLow(fromIdx, bar_index)
                        iConfirmLow  := pivot.new(ll, true, llBar)
                        iLastHigh    := pivot.new(high)
                        iRetracementStarted   := false
                        iLastIndBullBar       := LastIndependentBullishBar.new(low)
                        iRetracementStartLevel := iLastIndBullBar.low
                else if iSwingTrend.bias == bias.BEARISH
                    if not na(iConfirmHigh.price) and close > iConfirmHigh.price and iConfirmHigh.confirmed
                        line.new(x1=safeX1(iConfirmHigh.barIndex), y1=iConfirmHigh.price, x2=bar_index, y2=iConfirmHigh.price, color=GREEN, width=1)
                        int fromIdx = iConfirmHigh.barIndex
                        [ll, llBar] = getLowestLow(fromIdx, bar_index)
                        iConfirmLow  := pivot.new(ll, true, llBar)
                        iSwingTrend.bias      := bias.BULLISH
                        iLastHigh             := pivot.new(high)
                        iRetracementStarted   := false
                        iLastIndBullBar       := LastIndependentBullishBar.new(low)
                        iRetracementStartLevel := iLastIndBullBar.low
                    else if not na(iLastLow.price) and close < iLastLow.price and iLastLow.confirmed
                        line.new(x1=safeX1(iLastLow.barIndex), y1=iLastLow.price, x2=bar_index, y2=iLastLow.price, color=RED, width=1)
                        int fromIdx = iLastLow.barIndex
                        [hh, hhBar] = getHighestHigh(fromIdx, bar_index)
                        iConfirmHigh := pivot.new(hh, true, hhBar)
                        iLastLow     := pivot.new(low)
                        iRetracementStarted   := false
                        iLastIndBearBar       := LastIndependentBearishBar.new(high)
                        iRetracementStartLevel := iLastIndBearBar.high
            else
                if iSwingTrend.bias == bias.BULLISH
                    if not na(iConfirmLow.price) and close < iConfirmLow.price
                        iSwingTrend.bias      := bias.BEARISH
                        iConfirmHigh          := iLastHigh
                        iConfirmHigh.confirmed := true
                        iLastLow              := iConfirmLow
                        iConfirmLow           := pivot.new(na, false, na)
                        iLastHigh             := pivot.new(na, false, na)
                        iLastIndBullBar       := LastIndependentBullishBar.new(low)
                        iRetracementStartLevel := iLastIndBullBar.low
                        iRetracementStarted   := false
                else if iSwingTrend.bias == bias.BEARISH
                    if not na(iConfirmHigh.price) and close > iConfirmHigh.price
                        iSwingTrend.bias      := bias.BULLISH
                        iConfirmLow           := iLastLow
                        iConfirmLow.confirmed := true
                        iLastHigh             := iConfirmHigh
                        iConfirmHigh          := pivot.new(na, false, na)
                        iLastLow              := pivot.new(na, false, na)
                        iLastIndBearBar       := LastIndependentBearishBar.new(high)
                        iRetracementStartLevel := iLastIndBearBar.high
                        iRetracementStarted   := false
